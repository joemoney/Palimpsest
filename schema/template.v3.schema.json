{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.internal/schema/template.v3.schema.json",
  "title": "Palimpsest story template (schema v3)",
  "type": "object",
  "properties": {
    "schema_version": { "const": 3 },
    "story_version": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" },
    "narration": { "$ref": "#/$defs/narration" },
    "world": { "$ref": "#/$defs/world" },
    "protagonist": { "$ref": "#/$defs/protagonist" },
    "mechanics": { "$ref": "#/$defs/mechanics" },
    "plot": { "$ref": "#/$defs/plot" },
    "character_creation": { "$ref": "#/$defs/character_creation" }
  },
  "required": ["schema_version", "story_version", "meta", "narration", "world", "protagonist", "mechanics", "plot"],
  "patternProperties": { "^_": true },
  "additionalProperties": false,

  "$defs": {

    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "genre": { "type": "string" },
        "tone": { "type": "string" },
        "synopsis": { "type": "string" },
        "content_rules": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "narration": {
      "type": "object",
      "properties": {
        "pov": { "type": "string" },
        "option_pov": { "type": "string" },
        "scene_length": {
          "type": "object",
          "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "style": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["pov"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "world": {
      "type": "object",
      "properties": {
        "setting_summary": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } },
        "locations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/location" }
        },
        "factions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/faction" }
        },
        "characters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/character" }
        }
      },
      "required": ["setting_summary", "rules"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "location": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "connected_to": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "description"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "faction": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "goals": { "type": "string" },
        "relationship_to_player": { "type": "string" }
      },
      "required": ["name"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "character": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "role": { "type": "string" },
        "first_contact": { "type": "string" },
        "hook": { "type": "string" },
        "canon": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "protagonist": {
      "type": "object",
      "properties": {
        "default_name": { "type": "string" },
        "traits": { "type": "array", "items": { "type": "string" } },
        "starting_inventory": {
          "type": "array",
          "items": { "oneOf": [
            { "title": "Label only", "description": "A bare label, e.g. \"a brass key\". Read as an item with that label and nothing else.", "type": "string" },
            { "$ref": "#/$defs/item" }
          ] }
        },
        "stats": { "type": "object", "additionalProperties": { "type": "number" } },
        "background": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["default_name"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "character_creation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "prompt": { "type": "string" },
          "prompt_label": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "tagline": { "type": "string" },
                "starting_stats": { "type": "object", "additionalProperties": { "type": "number" } }
              },
              "required": ["id", "name"],
              "patternProperties": { "^_": true },
              "additionalProperties": false
            }
          }
        },
        "required": ["key", "label", "prompt", "options"],
        "patternProperties": { "^_": true },
        "additionalProperties": false
      }
    },

    "condition": {
      "$comment": "CR-02 (Story_Mechanics_Update.md): the canonical leaf spellings are {\"stat\": \"sync\", \"gte\": 70}, {\"revealed\": id}, {\"relationship\": name, \"tier_gte\": label}. The pre-overhaul gate forms - stat as {axis, at_least}, revelation, character-object relationship - stay accepted: CR-02 rewrites them, no template edits needed.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "revealed": { "type": "string" },
        "revelation": { "type": "string" },
        "flag": { "type": "string" },
        "item_tag": { "type": "string" },
        "turn_gte": { "type": "number" },
        "act_gte": { "type": "number" },
        "creation": { "type": "object", "additionalProperties": { "type": "string" } },
        "leverage_kind": { "type": "string" },
        "leverage_label_matches": { "type": "string" },
        "tier": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "tier_reached": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "gte": { "type": "number" },
        "lte": { "type": "number" },
        "between": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "tier_gte": { "type": "string" },
        "tier_lte": { "type": "string" },
        "peak_gte": { "type": "number" },
        "waypoints_done": {
          "oneOf": [{ "const": "all" }, { "type": "integer" }, { "type": "array", "items": { "type": "string" } }]
        },
        "subplot_status": { "type": "object", "additionalProperties": { "type": "string" } },
        "bond": {
          "$comment": "CR-11: a directed bond, [from, to], compared with gte/lte/between (score) or tier_gte/tier_lte (mechanics.bonds.tiers labels). A bond that has not opened yet reads as 0. Inside a side-thread recipe's eligible_when, from/to may be the recipe's cast slot names.",
          "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2
        },
        "stat": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "axis": { "type": "string" },
                "at_least": { "type": "number" },
                "at_most": { "type": "number" },
                "gte": { "type": "number" },
                "lte": { "type": "number" }
              },
              "required": ["axis"],
              "additionalProperties": false
            }
          ]
        },
        "relationship": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "character": { "type": "string" },
                "peak_gte": { "type": "number" },
                "gte": { "type": "number" },
                "lte": { "type": "number" }
              },
              "required": ["character"],
              "additionalProperties": false
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "stat": { "type": "string" } }, "required": ["stat"] },
          "then": { "anyOf": [{ "required": ["gte"] }, { "required": ["lte"] }, { "required": ["between"] }] }
        },
        {
          "if": { "properties": { "relationship": { "type": "string" } }, "required": ["relationship"] },
          "then": { "anyOf": [{ "required": ["tier_gte"] }, { "required": ["tier_lte"] },
                              { "required": ["peak_gte"] }, { "required": ["between"] }] }
        }
      ],
      "additionalProperties": false
    },

    "tier": {
      "type": "object",
      "properties": {
        "at": { "type": "number" },
        "label": { "type": "string" },
        "narration": { "type": "string" }
      },
      "required": ["at"],
      "if": { "required": ["narration"] },
      "then": { "required": ["label"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "stat_axis_tier": {
      "type": "object",
      "properties": {
        "at": { "type": "number" },
        "label": { "type": "string" },
        "narration": { "type": "string" },
        "clause_max_words": { "type": "integer" },
        "on_enter": {
          "$comment": "CR-01: fires on an upward crossing into this tier. Not built until S5 step 2; mechanics.validate() warns while nothing reads it.",
          "type": "object",
          "properties": {
            "once": { "type": "boolean" },
            "directive": { "type": "string", "minLength": 1 }
          },
          "required": ["directive"],
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      },
      "required": ["at"],
      "if": { "required": ["narration"] },
      "then": { "required": ["label"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "mechanics": {
      "type": "object",
      "properties": {
        "subplots": { "$ref": "#/$defs/engine_subplots" },
        "inventory": { "$ref": "#/$defs/engine_inventory" },
        "relationships": { "$ref": "#/$defs/engine_relationships" },
        "pacing_loop": { "$ref": "#/$defs/engine_pacing_loop" },
        "progression": { "$ref": "#/$defs/engine_progression" },
        "stats": { "$ref": "#/$defs/engine_stats" },
        "revelations": { "$ref": "#/$defs/engine_revelations" },
        "failure_conditions": { "$ref": "#/$defs/engine_failure_conditions" },
        "gate": { "$ref": "#/$defs/engine_gate" },
        "endings": { "$ref": "#/$defs/engine_endings" },
        "lore": { "$ref": "#/$defs/engine_lore" },
        "bonds": { "$ref": "#/$defs/engine_bonds" },
        "side_threads": { "$ref": "#/$defs/engine_side_threads" },
        "tracked_entity": { "$ref": "#/$defs/tracked_entity" },
        "flags": { "$ref": "#/$defs/flags" }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "flags": {
      "$comment": "CR-02: every flag a condition names must be declared here. Not an engine - no `engine` key, nothing to bind; the state-update pass is handed each `detect` so a declared flag can actually be set.",
      "type": "object",
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "detect": { "type": "string" }
            },
            "required": ["id"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "item": {
      "title": "Item record",
      "description": "An inventory item as the tagged_items engine keeps it. The engine mints ids for items gained in play; a starting item may author its own.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "What the model cites to spend or lose this item, e.g. itm_001." },
        "label": { "type": "string", "description": "What the item is, as the narrator sees it." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Kinds this item counts as, from mechanics.inventory.tags; gates and conditions test these (item_tag)." },
        "uses": { "type": "integer", "minimum": 0, "description": "Uses left. With uses, spending one decrements it; without, spending the item removes it." }
      },
      "required": ["label"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },
    "tracked_entity": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "pacing_note": { "type": "string" },
        "canon": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["name", "description"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_subplots": {
      "type": "object",
      "properties": {
        "engine": { "const": "weighted_threads" },
        "weights": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_inventory": {
      "type": "object",
      "properties": {
        "engine": { "const": "tagged_items" },
        "capacity": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_relationships": {
      "type": "object",
      "properties": {
        "engine": { "const": "scored_axis" },
        "scale": {
          "type": "object",
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "axis": {
          "type": "object",
          "properties": {
            "positive": { "type": "string" },
            "negative": { "type": "string" },
            "description": { "type": "string" }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "registers": { "type": "object", "additionalProperties": { "type": "number" } },
        "limit": { "type": "integer" },
        "tiers": { "type": "array", "items": { "$ref": "#/$defs/tier" } },
        "cap_per_window": {
          "type": "object",
          "properties": { "turns": { "type": "integer" }, "delta": { "type": "integer" } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "unreciprocated_factor": { "type": "number" }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["registers"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_pacing_loop": {
      "type": "object",
      "properties": {
        "engine": { "const": "beat_counter" },
        "beats": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "definition": { "type": "string" },
              "feeds": { "type": "string" },
              "resets": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["definition"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "watch": { "type": "string" },
              "threshold": {},
              "threshold_by_act": { "type": "object", "additionalProperties": {} },
              "max_deferrals": { "type": "integer" },
              "suppress_when": { "type": "array", "items": { "type": "string" } },
              "directive": { "type": "string" },
              "reduced_directive": { "type": "string" }
            },
            "required": ["id", "watch"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        },
        "tie_break": { "type": "string" },
        "counters": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["beats"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_progression": {
      "type": "object",
      "properties": {
        "engine": { "const": "spendable_ledger" },
        "label": { "type": "string" },
        "kinds": { "type": "array", "items": { "type": "string" } },
        "prompt_hint": { "type": "string" }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_stats": {
      "type": "object",
      "properties": {
        "engine": { "const": "bounded_counter" },
        "floor": { "type": "number" },
        "ceiling": { "type": "number" },
        "visible": { "type": "boolean" },
        "axes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "floor": { "type": "number" },
              "ceiling": { "type": "number" },
              "costs": { "type": "object", "additionalProperties": { "type": "number" } },
              "per_turn": { "type": "number" },
              "per_turn_interval": { "type": "integer" },
              "tiers": { "type": "array", "items": { "$ref": "#/$defs/stat_axis_tier" } }
            },
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        },
        "readout": {
          "type": "object",
          "properties": {
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "token": { "type": "string" },
            "entry_format": { "type": "string" },
            "separator": { "type": "string" },
            "delta_block": {
              "type": "object",
              "properties": {
                "marker": { "type": "string" },
                "clause_max_words": { "type": "integer" },
                "clause_max_words_axis": { "type": "string" },
                "fact_format": { "type": "string" },
                "separator": { "type": "string" },
                "wrapper": { "type": "string" }
              },
              "patternProperties": { "^_": true },
              "additionalProperties": false
            }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_revelations": {
      "$comment": "Fragments: information held back until a trigger happens on the page - backstory, a memory, lore, a secret, a clue. Not only memories: the narrator is shown revealed content under a neutral heading, so each entry's content says what it is. A revealed fragment is also a condition leaf ({\"revealed\": id}) for threads, acts and endings.",
      "type": "object",
      "properties": {
        "engine": { "const": "triggered_reveal" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "trigger": { "type": "string" },
              "content": { "type": "string" },
              "title": {
                "$comment": "Author-only name for the fragment, shown on the storyboard wherever a condition names it. The engine never reads it and it is never prompted.",
                "type": "string"
              },
              "after": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "trigger", "content"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["entries"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_failure_conditions": {
      "type": "object",
      "properties": {
        "engine": { "const": "triggered_ending" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "trigger": { "type": "string" },
              "title": { "type": "string" },
              "ending_prompt": { "type": "string" }
            },
            "required": ["id", "trigger", "ending_prompt"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["conditions"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_gate": {
      "type": "object",
      "properties": {
        "engine": { "const": "precondition" },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "target": { "type": "string" },
              "requires": { "$ref": "#/$defs/condition" },
              "refusal_hint": { "type": "string" }
            },
            "required": ["target"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["gates"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_lore": {
      "$comment": "CR-06 keyed lore. Written by the board at its final path (D1); the keyed_lore engine is not built yet, so a story authoring this block fails load_template() loudly until it is.",
      "type": "object",
      "properties": {
        "engine": { "const": "keyed_lore" },
        "max_active": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "priority": { "type": "number" },
              "keys": { "type": "array", "items": { "type": "string" } },
              "also_when": { "$ref": "#/$defs/condition" },
              "unlock": { "$ref": "#/$defs/condition" },
              "sticky_turns": { "type": "integer", "minimum": 0 },
              "content": { "type": "string" }
            },
            "required": ["id", "content"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["entries"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },
    "engine_bonds": {
      "$comment": "CR-11 NPC-to-NPC bonds. One-way scores: A->B and B->A are separate, so unrequited feeling is representable. Written by the board at its final path (D1); the scored_bonds engine is not built yet, so a story authoring this block fails load_template() loudly until it is.",
      "type": "object",
      "properties": {
        "engine": { "const": "scored_bonds" },
        "axis": {
          "description": "What the two ends of a bond mean, e.g. hostile and devoted.",
          "type": "object",
          "properties": { "negative": { "type": "string" }, "positive": { "type": "string" } },
          "additionalProperties": false
        },
        "registers": {
          "description": "The closed vocabulary of things one character does to or for another, each with the amount it moves the bond, e.g. covered_for_them: 8, betrayed_them: -15. The state-update pass may only name these.",
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "tiers": {
          "description": "Labels for score bands, highest first by convention. Labels only: the narrator sees a tier label, never a number. A narration key is refused until a measurement shows labels are not enough (CR-11 decision 2).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "at": { "type": "number" }, "label": { "type": "string" } },
            "required": ["at", "label"],
            "additionalProperties": false
          }
        },
        "seed": {
          "description": "Starting scores between authored characters. A pair with no seed opens at 0 on its first event.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" }, "to": { "type": "string" }, "score": { "type": "number" }
            },
            "required": ["from", "to", "score"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        },
        "max_generated_bonds": {
          "description": "How many bonds involving a generated character are kept. Past this, the one closest to neutral is evicted. Bonds between authored characters are never evicted.",
          "type": "integer", "minimum": 0
        },
        "cap_per_window": {
          "description": "The most one bond may move in either direction within a window of turns.",
          "type": "object",
          "properties": { "delta": { "type": "integer", "minimum": 1 }, "turns": { "type": "integer", "minimum": 1 } },
          "required": ["delta", "turns"],
          "additionalProperties": false
        }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["registers"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "side_cast_slot": {
      "$comment": "CR-11 (r5 A): one role in a side-thread recipe. kind defaults to character. A character slot draws from any / authored / generated / followed (the character a followed thread had in `slot`) / an authored character's name; it never binds a protected character. A location slot names a world.locations id; an item slot names an inventory tag.",
      "type": "object",
      "properties": {
        "kind": { "enum": ["character", "location", "item"] },
        "from": { "type": "string" },
        "slot": { "type": "string" },
        "id": { "type": "string" },
        "tag": { "type": "string" }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "side_recipe": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cast": {
          "description": "The recipe's roles, keyed by slot name (e.g. a, b, place). Conditions and may_move name slots, not people.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/side_cast_slot" }
        },
        "eligible_when": { "$ref": "#/$defs/condition" },
        "premise": {
          "description": "The situation the generator writes an episode from. Narrator-facing through the generated premise, so it goes through the leak check.",
          "type": "string"
        },
        "may_move": {
          "description": "The only values this episode's premise and end conditions may involve: bond:<slot>,<slot>, relationship:<slot>, stat:<axis>, item:<tag>, leverage:<kind>.",
          "type": "array",
          "items": { "type": "string", "pattern": "^(bond:[^,]+,[^,]+|relationship:.+|stat:.+|item:.+|leverage:.+)$" }
        },
        "may_create_npc": { "type": "boolean" },
        "follows": {
          "$comment": "CR-11 (r5 C) callback: this recipe follows a concluded side thread, at most once per thread. Local to recipes on purpose - not a condition leaf, so no ending can read a side thread's outcome. Outcomes: resolved (its end condition or detect hit), failed (its fails_when), expired (reached max_turns), finale (concluded when the story's finale began), abandoned (a player thread offered abandon_after_offers times without advancing, CR-12). recipe may be player_pursuit, the synthetic recipe every player-started thread uses.",
          "type": "object",
          "properties": {
            "recipe": { "type": "string" },
            "outcome": { "type": "array", "items": { "enum": ["resolved", "failed", "expired", "finale", "abandoned"] } },
            "min_turns_since": { "type": "integer", "minimum": 0 }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      },
      "required": ["id", "cast", "premise"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_side_threads": {
      "$comment": "CR-11 side threads: a separate track of short AI-written episodes, started and ended by state, never by the story's structure. Not subplots: no delivers, never counted toward act advancement. Written by the board at its final path (D1); the episodic_threads engine is not built yet, so a story authoring this block fails load_template() loudly until it is.",
      "type": "object",
      "properties": {
        "engine": { "const": "episodic_threads" },
        "max_active": { "description": "How many side threads can run at once. Their own pool: a side thread never takes an authored thread's slot.", "type": "integer", "minimum": 1 },
        "cooldown_turns": { "description": "Turns to wait after one side thread starts before another may.", "type": "integer", "minimum": 0 },
        "start_after_beats": {
          "description": "The pacing-loop beats after which a side thread may start. Names from mechanics.pacing_loop.beats.",
          "type": "array", "items": { "type": "string" }
        },
        "max_turns": { "description": "Every side thread ends by this many turns after it starts; the engine closes it if nothing else does.", "type": "integer", "minimum": 1 },
        "protected": {
          "description": "Authored characters no side thread may cast: someone whose arc the story needs to keep for itself.",
          "type": "array", "items": { "type": "string" }
        },
        "default_recipe": { "description": "When nothing authored is eligible, fall back to the built-in recipe: the pair with the strongest bond among characters seen recently. On unless set to false.", "type": "boolean" },
        "recipes": { "type": "array", "items": { "$ref": "#/$defs/side_recipe" } },
        "player_threads": {
          "$comment": "CR-12 player-started side threads: a pursuit the protagonist chose off the rails, confirmed in code by repeated reports, then run with every CR-11 guarantee (end conditions, detect, the max_turns backstop). Absent means the feature does not exist (P-2). Replaces the save's player_driven_goals once the engine is built.",
          "type": "object",
          "properties": {
            "max_active": { "description": "How many player-started threads can run at once. Their own count: the engine's pool never blocks one.", "type": "integer", "minimum": 1 },
            "confirm": {
              "description": "A pursuit opens a thread only after being reported this many times within this many turns, so one curious scene never becomes a thread.",
              "type": "object",
              "properties": {
                "reports": { "type": "integer", "minimum": 2 },
                "within_turns": { "type": "integer", "minimum": 2 }
              },
              "required": ["reports", "within_turns"],
              "additionalProperties": false
            },
            "abandon_after_offers": { "description": "A player thread offered this many times without advancing ends as abandoned: the player lost interest.", "type": "integer", "minimum": 1 },
            "may_move": {
              "description": "What a pursuit's premise and end conditions may involve. relationship:cast means the relationships of whoever the pursuit casts; otherwise relationship:<authored character>, stat:<axis>, item:<tag>, leverage:<kind>.",
              "type": "array",
              "items": { "type": "string", "pattern": "^(relationship:.+|stat:.+|item:.+|leverage:.+)$" }
            }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "vignettes": {
          "$comment": "CR-11 (r5 B): single scenes of texture, no thread and no generation call. Seeds are narrator-visible.",
          "type": "object",
          "properties": {
            "every": { "description": "At least this many turns between vignettes.", "type": "integer", "minimum": 1 },
            "seeds": { "type": "array", "items": { "type": "string" } },
            "subjects": { "type": "array", "items": { "enum": ["location", "character", "item"] } }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "engine_endings": {
      "type": "object",
      "properties": {
        "engine": { "const": "ending_funnel" },
        "check_every": { "type": "integer" },
        "budget": {
          "type": "object",
          "properties": {
            "open_until": { "type": "integer" },
            "narrow_until": { "type": "integer" },
            "commit_by": { "type": "integer" }
          },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "steer_top": { "type": "integer" },
        "finale_turns": {
          "type": "object",
          "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/ending_entry" } }
      },
      "if": { "required": ["engine"] },
      "then": { "required": ["entries"] },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "waypoint": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plant": { "type": "string" },
        "detect": { "type": "string" },
        "done_when": { "$ref": "#/$defs/condition" }
      },
      "required": ["id", "plant"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "ending_entry": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "description": "destination: an ending the story is steered toward (the storyboard's Destination ending). terminal: an ending reached through stats at any time, never steered toward (the storyboard's Failure ending). A catch-all is not a kind: it is a destination with no viable_while (the storyboard's Catch-all checkbox).",
          "enum": ["destination", "terminal"]
        },
        "name": { "type": "string" },
        "viable_while": {
          "$comment": "The ending stays possible only while this holds; the moment it goes false the ending is pruned for good. Leave it off to make this destination the catch-all (at least one is required).",
          "$ref": "#/$defs/condition"
        },
        "ready_when": { "$ref": "#/$defs/condition" },
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/waypoint" } },
        "hint": { "type": "string" },
        "criteria": { "type": "string" },
        "arc": {
          "type": "object",
          "properties": { "title": { "type": "string" }, "description": { "type": "string" } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        "epilogue": { "type": "string" },
        "min_turn": { "type": "integer" },
        "trigger": { "type": "string" }
      },
      "required": ["id", "kind"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "plot": {
      "type": "object",
      "properties": {
        "main_thread": { "$ref": "#/$defs/main_thread" },
        "subplots": { "type": "object", "additionalProperties": { "$ref": "#/$defs/subplot" } },
        "pacing": { "$ref": "#/$defs/pacing" },
        "initial_scene": { "$ref": "#/$defs/initial_scene" },
        "opening_scene": { "$ref": "#/$defs/opening_scene" }
      },
      "required": ["main_thread", "pacing", "initial_scene", "opening_scene"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "main_thread": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "plot_notes": { "type": "string" },
        "max_acts": { "type": "integer" },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "act_number": { "type": "integer" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "completion_signals": { "type": "array", "items": { "type": "string" } },
              "requires": { "$ref": "#/$defs/condition" },
              "is_finale": { "type": "boolean" },
              "optional": { "type": "boolean" }
            },
            "required": ["act_number", "title", "description"],
            "patternProperties": { "^_": true },
            "additionalProperties": false
          }
        }
      },
      "required": ["title", "description", "acts"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "subplot": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "completion_threshold": { "type": "integer" },
        "ties_to_main_plot": { "type": "string" },
        "span": { "enum": ["single_act", "multi_act"] },
        "starts_active": { "type": "boolean" },
        "role": { "enum": ["spine", "personal", "texture"] },
        "activate_when": { "$ref": "#/$defs/condition" },
        "delivers": { "type": "array", "items": { "type": "string" } },
        "cast": {
          "$comment": "The authored characters this thread involves (world.characters keys). Author-only for now: the storyboard uses it; no engine reads it yet, and it is never prompted.",
          "type": "array", "items": { "type": "string" }
        },
        "fail_when": { "$ref": "#/$defs/condition" },
        "on_complete": {
          "type": "object",
          "properties": { "stat_events": { "type": "array", "items": { "type": "string" } } },
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "pacing": {
      "type": "object",
      "properties": {
        "nudge_frequency": { "type": "integer" },
        "act_check_frequency": { "type": "integer" },
        "max_parallel_subplots": { "type": "integer" }
      },
      "required": ["nudge_frequency", "act_check_frequency"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "initial_scene": {
      "type": "object",
      "properties": { "location": { "type": "string" }, "summary": { "type": "string" } },
      "required": ["location", "summary"],
      "patternProperties": { "^_": true },
      "additionalProperties": false
    },

    "opening_scene": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "narration_before_name": { "type": "string" },
            "narration_after_name": { "type": "string" }
          },
          "required": ["narration_before_name", "narration_after_name"],
          "patternProperties": { "^_": true },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "narration": { "type": "string" } },
          "required": ["narration"],
          "patternProperties": { "^_": true },
          "additionalProperties": false
        }
      ]
    }
  }
}
